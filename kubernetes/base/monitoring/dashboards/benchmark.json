{
  "uid": "mtco-benchmark",
  "title": "Benchmark",
  "tags": [
    "mtco",
    "platform",
    "benchmark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Platform health",
      "type": "link",
      "url": "/d/mtco-platform-health"
    }
  ],
  "description": "TODO-25: số liệu cho báo cáo hiệu năng toàn dự án (đường ghi + đường đọc + tài nguyên).",
  "panels": [
    {
      "type": "text",
      "title": "Cách đọc",
      "options": {
        "mode": "markdown",
        "content": "Dùng khi chạy loadgen (`testing/loadgen`) hoặc đo tải đọc. **Đường ghi**: agent → Keycloak (token) → otel-gateway → VictoriaMetrics / OpenSearch. **Đường đọc**: Grafana → query-gateway → vmselect / OpenSearch. Chặng nào độ trễ tăng hoặc CPU chạm limit trước là nút thắt. Tất cả tính trên cửa sổ 5 phút: chạy tải ít nhất 10 phút rồi mới đọc số."
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Đường ghi",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Thông lượng: metric points / log records nhận mỗi giây",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate({__name__=~\"otelcol_receiver_accepted_metric_points(_total)?\",mtco_source=\"platform\"}[5m]))",
          "legendFormat": "metric points/s",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate({__name__=~\"otelcol_receiver_accepted_log_records(_total)?\",mtco_source=\"platform\"}[5m]))",
          "legendFormat": "log records/s",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(vm_rows_inserted_total{job=\"vminsert\",mtco_source=\"platform\"}[5m]))",
          "legendFormat": "rows/s vào VictoriaMetrics",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
