{
  "uid": "mtco-benchmark",
  "title": "Benchmark",
  "tags": [
    "mtco",
    "platform",
    "benchmark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Platform health",
      "type": "link",
      "url": "/d/mtco-platform-health"
    }
  ],
  "description": "TODO-25: numbers for the project-wide performance report (write path + read path + resources).",
  "panels": [
    {
      "type": "text",
      "title": "How to read",
      "options": {
        "mode": "markdown",
        "content": "Use while running loadgen (`testing/loadgen`) or `testing/bench`. **Write path**: agent → Keycloak (token) → otel-gateway → VictoriaMetrics / OpenSearch. **Read path**: Grafana → query-gateway → vmselect / OpenSearch. The stage whose latency rises or whose CPU hits its limit first is the bottleneck. Everything uses 5-minute windows: keep the load on for at least 10 minutes before reading numbers."
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Write path",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Throughput: metric points / log records accepted per second",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate({__name__=~\"otelcol_receiver_accepted_metric_points(_total)?\",mtco_source=\"platform\"}[5m]))",
          "legendFormat": "metric points/s",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate({__name__=~\"otelcol_receiver_accepted_log_records(_total)?\",mtco_source=\"platform\"}[5m]))",
          "legendFormat": "log records/s",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(vm_rows_inserted_total{job=\"vminsert\",mtco_source=\"platform\"}[5m]))",
          "legendFormat": "rows/s into VictoriaMetrics",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
