{
  "uid": "mtco-platform-health",
  "title": "Platform health",
  "tags": [
    "mtco",
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod (log)",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "description": "Filter logs by pod name; * = all, e.g. control-plane-*",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Benchmark",
      "type": "link",
      "url": "/d/mtco-benchmark"
    }
  ],
  "description": "TODO-25: metrics and logs of the MTCO platform itself (platform admins only). Sources: vmagent (mtco_source=platform) and log-collector.",
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Components being scraped (up)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "min by (job) (up{mtco_source=\"platform\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "1 = vmagent can scrape /metrics; 0 = it cannot."
    },
    {
      "type": "stat",
      "title": "Pods per component",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
